{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
   "@typescript-eslint/no-unused-vars": "off",
  "@typescript-eslint/no-namespace": "off",
  "@typescript-eslint/no-var-requires": "off"
  },
  "env": {
    "node": true,
    "es2022": true
  }
}
